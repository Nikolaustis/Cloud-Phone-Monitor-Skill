# Copy this file to ai.env for local use. The backend reads ai.env automatically;
# process environment variables override values from the file. ai.env is private
# and must never be committed.
# Cloud Phone Pricing Intelligence backend configuration.
# Keep provider secrets on the backend only. Never expose them through VITE_*.

AI_ENABLE_LLM=0
AI_LLM_PROVIDER=disabled

# To use an OpenAI-compatible chat-completions provider, set:
# AI_ENABLE_LLM=1
# AI_LLM_PROVIDER=openai_compatible
# AI_LLM_ENDPOINT=https://your-provider.example/v1/chat/completions
# AI_LLM_API_KEY=replace-me
# AI_LLM_MODEL=replace-me
AI_LLM_ENDPOINT=
AI_LLM_API_KEY=
AI_LLM_MODEL=

AI_CONTEXT_DIR=dashboard/public/dashboard_data/ai
# Optional remote safe context, e.g. your GitHub Pages dashboard_data/ai directory.
AI_CONTEXT_BASE_URL=

AI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://nikolaustis.github.io
AI_RATE_LIMIT_PER_MINUTE=30
AI_MAX_TOOL_ROUNDS=4
AI_REQUEST_TIMEOUT_SECONDS=45
AI_HOST=127.0.0.1
AI_PORT=8787

# Rebuild local ai-context-v2 from dashboard_data at API startup.
AI_AUTO_BUILD_CONTEXT=1
